VITE_API_BASE_URL=http://localhost:5000/api
# Same-origin local/deployed ERP by default. Set an absolute ERP origin/path
# only when the ERP is deployed separately, e.g. https://erp.example.com.
VITE_ERP_URL=/erp

# ERP Supabase configuration. Use the public publishable key, or the legacy
# anon key variable if that is what the existing Supabase project provides.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_KEY
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
